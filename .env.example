# local：默认体验级，无需启动服务或设置密钥；server：连接生产 Qdrant，必须设置 URL 和密钥。
QDRANT_MODE=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# lite：默认体验级，保存为本地 .db 文件；server：连接 Docker Standalone 或分布式 Milvus。
MILVUS_MODE=lite
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_PORT=19530
MILVUS_WEBUI_PORT=9091
MILVUS_MINIO_PORT=19000
MILVUS_MINIO_CONSOLE_PORT=19001
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin
