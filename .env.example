# 百炼 Embedding 与 Stage 4 文本生成。真实密钥只写入本地 .env。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus

# local：默认体验级，无需启动服务或设置密钥；server：连接生产 Qdrant，必须设置 URL 和密钥。
QDRANT_MODE=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# lite：默认体验级，保存为本地 .db 文件；server：连接 Docker Standalone 或分布式 Milvus。
MILVUS_MODE=lite
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_PORT=19530
MILVUS_WEBUI_PORT=9091
MILVUS_MINIO_PORT=19000
MILVUS_MINIO_CONSOLE_PORT=19001
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin

# disabled：默认不启动；server：连接独立 LightRAG Server。服务端和本应用必须使用同一密钥。
LIGHTRAG_MODE=disabled
LIGHTRAG_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_PORT=9621
LIGHTRAG_TIMEOUT=180

# Seedance 竖屏开场；真实密钥只写入本地 .env。
SEEDANCE_ARK_API_KEY=
SEEDANCE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-5-260628
SEEDANCE_RATIO=9:16
SEEDANCE_DURATION=10
SEEDANCE_RESOLUTION=720p
SEEDANCE_AUDIO=1
SEEDANCE_OUTPUT_DIR=videos/vector-rag-long-tutorial/seedance
SEEDANCE_SUBMIT=0
SEEDANCE_POLL_SECONDS=10
SEEDANCE_TIMEOUT_SECONDS=1200
TUTORIAL_START_SECONDS=13.393
